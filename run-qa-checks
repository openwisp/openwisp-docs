#!/bin/bash

set -e

# openwisp-utils checks
openwisp-qa-check \
    --skip-checkmigrations \
    --skip-checkmakemigrations\
    --skip-isort \
    --skip-flake8 \
    --skip-black \
    --skip-checkendline

# Check only tracked source assets, not generated documentation or fetched modules.
git ls-files -z -- '*.css' '*.js' '*.md' '*.yaml' '*.yml' |
    xargs -0r prettier --check --print-width 88

python sort_spelling_wordlist.py --qa || \
  (echo "Spelling Vocabulary not up to date"; exit 1)
